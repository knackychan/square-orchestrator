        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Square Orchestrator — Bootstrap"
        Width="1100" Height="720" MinWidth="760" MinHeight="480">
  <Grid Margin="24">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="720">
      <TextBlock FontSize="28" FontWeight="SemiBold" Text="Square Orchestrator" />
