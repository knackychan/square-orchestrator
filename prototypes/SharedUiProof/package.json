{
  "name": "square-shared-ui-proof",
  "displayName": "Square Shared UI Proof",
  "description": "SP00-T04: the same bounded xterm.js workspace hosted by WPF/WebView2 and a VS Code webview.",
  "publisher": "square-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.19.0",
    "vscode": "^1.108.0"
  },
  "main": "./dist/src/vscode/extension.js",
  "activationEvents": [
    "onCommand:square.sharedUiProof.open",
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "square.sharedUiProof.open",
        "title": "Square: Open Shared UI Proof",
        "category": "Square"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:host-neutral": "node scripts/build.mjs --skip-vendor",
    "clean": "node scripts/build.mjs --clean",
    "test": "node scripts/build.mjs --skip-vendor && node --test test/*.test.mjs",
    "validate": "node validate-source.mjs",
    "manifest": "node scripts/source-manifest.mjs --write"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0"
  }
}
