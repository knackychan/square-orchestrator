-- Semantic events are append-only and update current projections in the same
-- transaction through the service/store boundary.
CREATE TABLE square_events (
    sequence INTEGER PRIMARY KEY AUTOINCREMENT,
    event_id TEXT NOT NULL UNIQUE,
    stream_kind TEXT NOT NULL,
    stream_id TEXT NOT NULL,
    stream_version INTEGER NOT NULL,
    event_type TEXT NOT NULL,
    schema_version TEXT NOT NULL,
    payload_json TEXT NOT NULL,
    occurred_at TEXT NOT NULL,
    UNIQUE (stream_kind, stream_id, stream_version)
) STRICT;

CREATE TRIGGER square_events_no_update
BEFORE UPDATE ON square_events
BEGIN
    SELECT RAISE(ABORT, 'square_events is append-only');
END;

CREATE TRIGGER square_events_no_delete
BEFORE DELETE ON square_events
BEGIN
    SELECT RAISE(ABORT, 'square_events is append-only');
END;

